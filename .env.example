# 1) Copy this file to a new file named ".env"   (cp .env.example .env)
# 2) Paste your Stripe TEST keys from https://dashboard.stripe.com/test/apikeys
# NEVER commit the real .env file (it is already in .gitignore).

# Secret key: used ONLY by the server (server/index.js). Starts with sk_test_
STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key: safe for the browser. Starts with pk_test_
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
